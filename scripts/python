#!/bin/sh
# Local macOS workaround for Homebrew Python loading Apple's older libexpat.
# This affects this process only; no shell configuration is changed.
if [ "$(uname -s)" = Darwin ] && [ -d /opt/homebrew/opt/expat/lib ]; then
  export DYLD_LIBRARY_PATH="/opt/homebrew/opt/expat/lib${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
fi
repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir" || exit 1
exec "$repo_dir/.venv-search312/bin/python" "$@"
